{
  "compilerOptions": {
    "baseUrl": "src",
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "es6",
    "lib": ["es2021", "dom"],
    "moduleResolution": "node",
    "target": "es2021",
    "jsx": "react",
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/node_modules/*"]
}
